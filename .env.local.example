# Shopify Storefront API — see README.md "Connecter Shopify" for the
# step-by-step guide to generate these in the Shopify admin.
SHOPIFY_STORE_DOMAIN=luxbois33.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Optional: Shopify variant GID for the "livré rangé sur palette" (+29 €)
# delivery option, so it appears as a real line item at checkout.
SHOPIFY_DELIVERY_RANGE_VARIANT_ID=
